{# ------- Extends Main Layout ------- #}
{% extends "_layouts/_main" %}

{# ------- Define variables ------- #}
{% set currentUrl = craft.app.request.url %}

{# ------- Block: head ------- #}
{% block head %}

{% endblock %}

{# ------- Block: body ------- #}
{% block body %}

    {# TODO - create a card for these individual tests (title, subtitle, button, etc. that works for all these different tests and UI elements)  #}
    {# TODO - Idea - download my weight data from Wyze (entire history), use FeedMe to import the data, then create a visual from the data to disaply on the front end #}
    {# TODO - transfer playground to craft4.test project and continue test development there #}
