    {# web component #}
    <butt-butts></butt-butts>

    {# hidden inputs #}
    <input id="userId" type="hidden" name="userId" value="{{ currentUser.id }}">
    {{ csrfInput() }}


    {# container #}
{#    <div class="min-h-screen w-full md:flex px-2 py-2 space-y-2 md:space-y-0 md:space-x-2">#}
    <div class="min-h-screen w-full px-2 py-2 space-y-2">
        {# card design #}
        <div class="w-full self-start md:w-1/2 lg:w-1/4 bg-blue-300 px-4 py-6 rounded">
            {# title #}
            <p class="h4 text-white">Title AJAX</p>
            {# results #}
            <div class="results"></div>
            {# button #}
            <button class="btn text-white border-white text-xs">button</button>
        </div>

        {# various tests #}
        <div class="space-y-2">
            {# destructuring #}
            <div class="border rounded px-4 py-2 space-y-3">
                <div id="contact">
                    <p id="name">Chris Brown</p>
                    <p id="handle">CBreazy</p>
                    <p id="location">Traverse City, MI</p>
                </div>
                <button id="destructure" class="btn">destructure</button>
            </div>

            {# promise #}
            <button id="promiseAll" class="btn">promise</button>

            {# xml ajax #}
            <div class="border rounded px-4 py-2 space-y-3">
                <div id="xhrResults"></div>
                <button id="xhr" class="btn">xml ajax call</button>
            </div>

            {# fetch #}
            <div class="border rounded px-4 py-2 space-y-3">
                <div id="fetchResults"></div>
                <button id="fetching" class="btn">fetching</button>
            </div>

            {# userInfo via twig extension #}
            {% if currentUser %}
                <div class="border rounded px-4 py-2 space-y-3">
                    <div>
                        <h6>Account Info</h6>
                        <p class="text-xs">(retrieved via twig extension)</p>
                        <ul>
                            {% set results = getUserInfo(1) %}
                            {% for key, value in results %}
                                <li>{{ key }} :{{ value }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}

        {# userInfo via POST request to Controller #}
        {% if currentUser %}
            <div class="border rounded px-4 py-2 space-y-3">
                <div id="userInfoResults"></div>
                <button id="userInfoBtn" class="btn">fetch user info</button>
                <button id="removeInfo" class="btn hidden">remove info</button>
            </div>
        {% endif %}
    </div>

        <my-component></my-component>

        {# JS Module #}
        <div class="border rounded px-4 py-2">
            <h1>Users</h1>
            <ul id="users"></ul>
            <input
              id="input"
              type="text"
              placeholder="New User">
            </input>
            <button class="btn" id="submit">Submit</button>
        </div>
    </div>

    {# Test Form #}
    {{ include('/_forms/_test1.twig') }}

{% endblock %}

{# ------- Block: js ------- #}
{% block js %}
    <script>

        /* -------------- */
        /* globals */
        /* -------------- */
        const destructure = document.getElementById("destructure");
        const promiseAll = document.getElementById("promiseAll");
        const xhr = document.getElementById("xhr");
        const fetching = document.getElementById("fetching");
        const userInfoBtn =  document.getElementById("userInfoBtn");
        const removeInfo =  document.getElementById("removeInfo");

        /* -------------- */
        /* event listeners */
        /* -------------- */
        /* destructure object and assign variables */
        destructure.addEventListener("click", (e) => {
            let profile = {
                n: e.target.closest('div').querySelector('#name').innerHTML,
                h: e.target.closest('div').querySelector('#handle').innerHTML,
                l: e.target.closest('div').querySelector('#location').innerHTML,
            }
            console.log(profile);

            // destructure and create new vars at same time
            const {n: name, h: handle, l: location} = profile;

            console.log(name, handle, location);
        });

        /* chaining async functions with Promise.all() - https://ui.dev/c/modern-javascript/object-array-destructuring */
        promiseAll.addEventListener("click", (e) => {
            Promise.all([sum({num1: 1, num2: 1}), 10]).then(
                ([sum, constant]) => {
                    console.log(sum + constant);
                }
            )
        });

        /* basic ajax call on click */
        xhr.addEventListener("click", loadDoc);

        // basic fetch
        fetching.addEventListener("click", (e) => {
            let url = 'https://craft4.test/documents/ajax-info-obj.txt';
            fetch(url, {method: 'GET'}).then(Result => Result.json()).then(string => {
                // log response
                console.log(string);
                // Printing a field of our response
                console.log(`Title of our response :  ${string.title}`);
            }).catch(errorMsg => {
                console.warn(errorMsg);
            })
        });

        // post to controller and receive user info
        userInfoBtn.addEventListener("click", displayUserInfo);

        // remove user info from the results div
        removeInfo.addEventListener('click', removeUserInfo);

        /* -------------- */
        /* functions */
        /* -------------- */
        // loadDoc - returns hardcoded text file via ajax XML request
        function loadDoc() {
            // create request object
            let xhr = new XMLHttpRequest();

            // making connection
            let url = 'https://craft4.test/documents/ajax-info.txt';
            xhr.open("GET", url, true);

            // execute after successful request
            xhr.onreadystatechange = function() {
                if (this.readyState == 4 && this.status == 200) {
                    console.log(this.responseText);
                    document.getElementById('xhrResults').innerHTML = this.responseText;
                }
            };
            // send request
            xhr.send();
        }

        // sum - return sum of 2 numbers
        // set the default value of each property in the same place where we just destructured the parameters
        // because we are passing in an object, the order of the parameters no longer matters
        const sum = ({num1 = 0, num2 = 0}) => {
            return num1 + num2;
        }

        // POST request to a php controller in module\playground
        // displayUserInfo
        function displayUserInfo() {
            // Set the form values
            let formData = new FormData(),
                csrfToken = document.querySelector("input[name='CRAFT_CSRF_TOKEN']").value,
                userId = document.getElementById("userId").value;
            formData.append('CRAFT_CSRF_TOKEN', csrfToken);
            formData.append('userId', userId);

            // fetch returns a promise that resolves with the HTTP response
            fetch('/actions/booty/app/get-user-info', {
                method: 'POST',
                body: formData,
            }).then((response) => {
                // read a string (results from POST request) out of the response using text()
                // .text() returns a promise that resolves with a string
                return response.text();
            }).then(data => {
                // store response as userData
                let userData = JSON.parse(data);
                // destructure and create new vars at same time
                const {userName: userName, fullName: fullName, email: email} = userData;
                // results container
                let resultsContainer = document.getElementById('userInfoResults');
                // Update the results container using template literals
                resultsContainer.innerHTML = `<p class="userDatum">${userName}</p>
                                              <p class="userDatum">${fullName}</p>
                                              <p class="userDatum">${email}</p>`;
                // hide the fetch button
                userInfoBtn.classList.add('hidden');
                // show the remove info button
                removeInfo.classList.remove('hidden');
            }).catch(function (err) {
                // Failure
                console.warn('FAIL!', err);
            });
        };
        // removeUserInfo
        function removeUserInfo() {
            let userData = document.querySelectorAll('.userDatum');
            userData.forEach((datum) => {
                datum.remove();
            });
            // hide the remove info button
            removeInfo.classList.add('hidden');
            // show the display data button
            userInfoBtn.classList.remove('hidden');
        }

        /* --------------------- */
        /* Promises */
        /* --------------------- */
        function onSuccess() {
            console.log("success!");
        }

        function onError() {
            console.log("💩!");
        }

        function getPromise(id) {
            return new Promise((resolve) => {
                setTimeout(resolve({one: 'one', two: 'two', three: 'three'}), 2000);
            })
        }

        // function stored in reference
        const logA = (data) => {
            return new Promise((resolve, reject) => {
                if (data) {
                    console.log("A: resolving with data");
                    resolve({data: data});
                } else {
                    reject();
                }
            });
        }

        const logB = (data) => {
            console.log(`B: ${data}`);
        }

        function logCAndThrow() {
            console.log("C");

            throw new Error();
        }

        function catchError() {
            console.log("Error!");
        }

        getPromise()
            .then(logA) // data (reference)
            .then(logB) // B (function)
            .then(logCAndThrow) // C
            .catch(catchError); // Error!

        // async functions return a promise
        // if the function returns a value it is also wrapped in a promise and required .then() to access it
        // example below
        async function testAsync(x, y) {
            if (typeof x === "number" && typeof y === "number") {
                return x + y;
            } else {
                return "please use numbers"
            }
        }

        try {
          console.log(testAsync("u", 2).then((response) => {
            console.log(`response: ${response}`);
        }));
        } catch (e) {
            console.log(e);
        }

        /* ---------------------- */
        /* web components testing */
        /* ---------------------- */
        // butts
        class butts extends HTMLElement {
            // The browser calls this method when the element is
            // added to the DOM.
            connectedCallback() {
                this.innerHTML = "show butts"
            }
        }
        // MyComponent
        class MyComponent extends HTMLElement {
            constructor() {
                super();
                this.shadow = this.attachShadow({ mode: "open" });
            }

            connectedCallback() {
                this.shadow.innerHTML = `
                <p>Hello from a web component!</p>
                <style>
                    p {
                      color: pink;
                      font-weight: bold;
                      padding: 1rem;
                      border: 4px solid pink;
                    }
                </style>`;
            }
        }

        /* define custom components */
        customElements.define('butt-butts', butts);
        customElements.define('my-component', MyComponent);

        /* ---------------------- */
        /* objects */
        /* ---------------------- */
        // always ensure that the "new" keyword is used when creating class
        function Animal(name, energy) {
            if (this instanceof Animal === false) {
                return new Animal(name, energy);
            }

            this.name = name;
            this.energy = energy;
        }

        // attaching shared methods to the objects prototype
        Animal.prototype.eat = function (amount) {
          console.log(`${this.name} is eating.`);
          this.energy += amount;
        };

        Animal.prototype.sleep = function (length) {
          console.log(`${this.name} is sleeping.`);
          this.energy += length;
        };

        Animal.prototype.play = function (length) {
          console.log(`${this.name} is playing.`);
          this.energy -= length;
        };

        // using "new" to call constructor function Animal create the "this" object for us and implicitly returns it (pattern: Pseudoclassical Instantiation)
        const leo = new Animal("Leo", 7);
        const snoop = new Animal("Snoop", 10);

        leo.eat(10);
        snoop.play(5);

        /* ---------------------- */
        /* classes */
        /* ---------------------- */

        /*
        * Whenever you have a method that is specific to a class itself but
        * doesn't need to be shared across instances of that class, you can add
        * it as a static property of the class.
        *
        *
        * */


        class Thing {
            constructor(name, energy) {
                this.name = name;
                this.energy = energy;
            }
            eat(amount) {
                console.log(`${this.name} is eating.`);
                this.energy += amount;
            }
            sleep(length) {
                console.log(`${this.name} is sleeping.`);
                this.energy += length;
            }
            play(length) {
                console.log(`${this.name} is playing.`);
                this.energy -= length;
            }
            static nextToEat(animals) {
                const sortedByLeastEnergy = animals.sort((a, b) => {
                  return a.energy - b.energy;
                });

                return sortedByLeastEnergy[0].name;
                }
            }

        const jonny = new Thing("jonny", 7);
        const goop = new Thing("goop", 10);

        console.log(`next animal to eat is ${Thing.nextToEat([jonny, goop])}`); // Leo
        console.log(`is goop an instance of Thing? ${goop instanceof Thing}`);
    </script>
{% endblock %}