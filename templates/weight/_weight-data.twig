{# ------- Extends Main Layout ------- #}
{% extends "_layouts/_main" %}

{# ------- Define variables ------- #}
{% set currentUrl = craft.app.request.url %}
{% set weightEntries = craft.entries().section("weight").all() %}
{% set chartData = [] %}
{% for data in weightEntries|sort((a, b) => a.title <=> b.title) %}
    {% set chartData = chartData|merge([{"date" : data.title, "weight" : data.weight}]) %}
{% endfor %}

{# ------- Block: head ------- #}
{% block head %}

{% endblock %}

{# ------- Block: body ------- #}
{% block body %}
    <div>
        <div class="w-full mx-auto my-10 px-10">
            <h2 class="px-10">{{ entry.title }}</h2>
            <canvas id="weightChart"></canvas>
        </div>
    </div>
{% endblock %}

{# ------- Block: js ------- #}
{% block js %}
    <script>
        window.APP.weightChart({{ chartData|json_encode|raw }});
    </script>
{% endblock %}